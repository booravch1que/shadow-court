{
  "name": "shadow-court",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time multiplayer bluffing card game for 2-6 players (working title).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @shadow-court/web build",
    "dev": "pnpm -r --parallel --filter @shadow-court/server --filter @shadow-court/web dev",
    "start": "pnpm --filter @shadow-court/server start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
